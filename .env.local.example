# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS · contrato de seguridad (ver "REGLA ABSOLUTA" en CLAUDE.md)
#   1. La IA crea .env.local con copia opaca:  cp .env.local.example .env.local
#   2. La IA lista las KEYS que faltan; NUNCA lee ni pide valores por chat.
#   3. TU (humano) pegas aqui los valores reales con tu editor.
#   4. La IA solo verifica existencia:  grep -c '^NOMBRE_VAR=' .env.local  (0/1)
#   Ningun agente lee el CONTENIDO de este fichero. Solo se copia de forma opaca.
#   NUNCA commitees .env.local (esta en .gitignore). Cero backups versionados.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tu App

# Email · Resend (skills /email-token-based y /add-emails)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Tu App <noreply@tudominio.com>"
EMAIL_REPLY_TO=hola@tudominio.com

# AI · OpenRouter (skill /ai · 300+ modelos)
OPENROUTER_API_KEY=
